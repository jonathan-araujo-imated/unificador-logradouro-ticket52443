
// DEPOIS USAR A API DE DELETE PRA REMOVER ENDEREÇOS INVALIDOS, USANDO A MESMA ESTRUTURA ABAIXO APENAS DEIXANDO ID GERADO E MUDANDO O MÉTODO DA REQUISIÇÃO

// Alegria
filtroEnderecos = "bairro.id in (2362056,2957561,2442173,2089798,2090304,2089114,2093189,2089136,2089210,2090763,2091153,2092309,2093204,2092284,2090604,  2089649,3348619,2592799,2789579,2898779,2092529,2089115,2089967,2090847,2093212,2093339,2090297,2900699,2090948)" // id certo >> 2092517
fonteEnderecos = Dados.tributos.v2.contribuintes.enderecos;
dadosEnderecos = fonteEnderecos.busca(criterio: filtroEnderecos)
percorrer(dadosEnderecos) {
    i ->
    imprimir i

    conteudo = [
        idIntegracao: "$i.id",
        pessoasEnderecos: [
            idGerado: [
                id: i.id
            ],
            idPessoa: i.idContribuinte,
            idBairro: 2092517,
            principal: "$i.principal.valor",
            ordem: 1
        ]
    ];  
    imprimir "JSON: " + JSON.escrever(conteudo);
    url = "https://tributos.betha.cloud/service-layer-tributos/api/pessoasEnderecos"
    requisicao = Http.servico(url).chaveIntegracao(Variavel.token)
    requisicao = requisicao.PATCH(JSON.escrever(conteudo), Http.JSON)
    imprimir "LOTE: " + requisicao.conteudo()
    se(!(requisicao.codigo() in 200..205)) {
      imprimir "ERRO => ${requisicao.codigo()} => ${requisicao.conteudo()}"
    }
}

