  percorrer (fonteContribuintes) { c ->
    imprimir c.codigo
    
    // ------------------------------------------------------------------------------------------------------------
    // CONTADOR PARA VER SE HÁ NECESSIDADE DE ENVIO DE DADOS
    // ------------------------------------------------------------------------------------------------------------
    
    temErro = 0
    
    // ------------------------------------------------------------------------------------------------------------
    // 	CAPTANDO O JSON A SER CORRIGIDO
    // ------------------------------------------------------------------------------------------------------------
    
    requisicao = Http.servico('https://tributos.betha.cloud/tributos/v1/api/cadastros/referentes/contribuintes/'+c.id)
    .cabecalho('Authorization', bearer)
    .cabecalho('User-Access', userAcess)  
    requisicao = requisicao.GET()
    jsonCorrigido =  JSON.ler(requisicao.conteudo())  
    // ------------------------------------------------------------------------------------------------------------
    // 	VARIAVEIS
    // ------------------------------------------------------------------------------------------------------------
    naturezaJud = nulo;
    qualificaJud = nulo;
    porteEmp = "-";
    optanteSN = "-";
    rgDocumento = nulo;
    obito = nulo;
    nascimento = nulo;
    inscEstadual = "-";
    inscMunicipal = jsonCorrigido.inscricaoMunicipal?:"-";
    
    se(c.tipoPessoa.valor == 'FISICA'){
      rgDocumento = c.pessoaFisicaDocumentos?.nroRg?:nulo;
      obito = "$c.pessoaFisica.dtObito" == "Wed Jan 01 00:00:00 BRT 1800" ? nulo : c.pessoaFisica.dtObito
      nascimento = "$c.pessoaFisica.dtNascimento" == "Wed Jan 01 00:00:00 BRT 1800" ? nulo : c.pessoaFisica.dtNascimento    
    }
    se(c.tipoPessoa.valor == 'JURIDICA'){
      naturezaJud = c.pessoaJuridica?.naturezaJuridica?.id?:nulo;
      qualificaJud = c.pessoaJuridica?.qualificacao?.id?:nulo;
      porteEmp = jsonCorrigido?.pessoaJuridica?.porteEmpresa?:"-";
      optanteSN = c.optanteSimplesNacional?.valor?:"-";
      inscEstadual = jsonCorrigido.pessoaJuridica?.inscricaoEstadual?:"-";
    }   
    
    // ------------------------------------------------------------------------------------------------------------
    // 	CORREÇÃO DE QUALIFICAÇÕES INDEVIDAS
    // ------------------------------------------------------------------------------------------------------------
    
    se(naturezaJud!=nulo && qualificaJud!=nulo){
      
      requisicao = Http.servico('https://tributos.betha.cloud/tributos/v1/api/cadastros/cadastros-auxiliares/qualificacoes?filter=(descricao+like+%22%2525%2525%22)+and+naturezaJuridica.id+%3D+'+naturezaJud+'&limit=25&offset=0&sort=descricao+asc')
      .cabecalho('Authorization',bearer)
      .cabecalho('User-Access',userAcess)  
      requisicao = requisicao.GET()
      variavelGet =  JSON.ler(requisicao.conteudo())
      
      se(!(qualificaJud.toInteger() in variavelGet.content.id)){
        imprimir "entrou CORREÇÃO DE QUALIFICAÇÕES INDEVIDAS"
        identificador = MapaQualificacao[naturezaJud.toInteger()]?.id?:null
        descricaoNat = MapaQualificacao[naturezaJud.toInteger()]?.descricao?:null
        
        jsonCorrigido.pessoaJuridica.qualificacao = [id: identificador , descricao: "$descricaoNat"]
        
        temErro += 1
        //imprimir  jsonCorrigido
      }
    }
    
    // ------------------------------------------------------------------------------------------------------------
    // 	CORREÇÃO DE INSCRICAO ESTADUAL/MUNICIPAL INDEVIDA
    // ------------------------------------------------------------------------------------------------------------
    
    se(inscEstadual.size() > removeLetra(inscEstadual).size()){
      jsonCorrigido.pessoaJuridica.inscricaoEstadual = nulo   
      temErro += 1
       imprimir "entrou INSCRICAO ESTADUAL INDEVIDA"
    }
    se(inscMunicipal.size() > removeLetra(inscMunicipal).size()){
      jsonCorrigido.inscricaoMunicipal = nulo
      temErro += 1
       imprimir "entrou INSCRICAO MUNICIPAL INDEVIDA"
    }
    // ------------------------------------------------------------------------------------------------------------
    // 	CORREÇÃO DE OPTANTES DO SIMPLES - SOMENTE AS OPÇÕES DE PORTE ABAIXO PODEM SER OPTANTES
    // ------------------------------------------------------------------------------------------------------------
    listaNaoOptantes = ['EMPRESA_GRANDE_PORTE','NAO_CLASSIFICADA','EMPRESA_MEDIO_PORTE']
    se(optanteSN == 'SIM' && porteEmp in listaNaoOptantes){      
      imprimir "entrou ORREÇÃO DE OPTANTES DO SIMPLES"
      jsonCorrigido.pessoaJuridica.porteEmpresa = "DEMAIS"  
      temErro += 1
      //imprimir  jsonCorrigido
    }
    // ------------------------------------------------------------------------------------------------------------
    // 	CORREÇÃO DE MICROEMPREENDEDOR_INDIVIDUAL - NÂO PODE POSSUIR SÓCIOS
    // ------------------------------------------------------------------------------------------------------------
    
    se(porteEmp == 'MICROEMPREENDEDOR_INDIVIDUAL' && jsonCorrigido.socios != nulo){ 
      imprimir "entrou CORREÇÃO DE MICROEMPREENDEDOR_INDIVIDUAL"
      jsonCorrigido.socios = nulo   
      temErro += 1
      //imprimir  jsonCorrigido
    }
    
    // ------------------------------------------------------------------------------------------------------------
    // 	CORREÇÃO DATA DE ÓBITO
    // ------------------------------------------------------------------------------------------------------------
    
    se(nascimento != nulo && obito != nulo && obito < nascimento){
      imprimir "entrou CORREÇÃO DATA DE ÓBITO"
      jsonCorrigido.pessoaFisica.dtObito = nulo
      temErro += 1
      //imprimir  jsonCorrigido
    }
    
    // ------------------------------------------------------------------------------------------------------------
    // 	CORREÇÃO DE RG INVALIDO
    // ------------------------------------------------------------------------------------------------------------
    tamanhoRg = rgDocumento?.size()?:0
    rgDocumentoZeros = rgDocumento?.replace("0","")?:""
    rgDocumentoNoves = rgDocumento?.replace("9","")?:""
    se(rgDocumento != nulo && ( rgDocumentoNoves.size() <= 0 || rgDocumentoZeros.size() <= 0 || tamanhoRg < 6 )){        
      imprimir "entrou CORREÇÃO DE RG INVALIDO"
      jsonCorrigido.pessoaFisicaDocumento.nroRg = nulo 
      jsonCorrigido.pessoaFisicaDocumento.orgaoEmissorRg = nulo   
      jsonCorrigido.pessoaFisicaDocumento.estadoRg = nulo   
      jsonCorrigido.pessoaFisicaDocumento.dtEmissaoRg = nulo           
      temErro += 1
      //imprimir  jsonCorrigido
    }
    
    // ------------------------------------------------------------------------------------------------------------
    // 	ENVIO DEFINITIVO DOS DADOS
    // ------------------------------------------------------------------------------------------------------------
    se(temErro > 0){
      imprimir jsonCorrigido
      imprimir "entrou no envio"
      requisicao = Http.servico('https://tributos.betha.cloud/tributos/v1/api/cadastros/referentes/contribuintes/'+c.id)
      .cabecalho('Authorization',bearer)
      .cabecalho('User-Access',userAcess)  
      requisicao = requisicao.PUT(JSON.escrever(jsonCorrigido), Http.JSON)
      
      se(!(requisicao.codigo() in 200..205)){
        imprimir "ERRO => ${requisicao.codigo()} => ${requisicao.conteudo()}"
      }
      esperar 1.segundo
    }
