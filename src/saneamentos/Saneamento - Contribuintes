removeLetra = {a ->
  return a.expressao(~/[à|á|ã|â]/).substituirPor("")
  .expressao(~/[Á|Ã|À|Â]/).substituirPor("")
  .expressao(~/[é|ê]/).substituirPor("")
  .expressao(~/[É|É]/).substituirPor("")
  .expressao(~/[í|î]/).substituirPor("")  
  .expressao(~/[Í|Î]/).substituirPor("")  
  .expressao(~/[õ|ó|ô]/).substituirPor("")  
  .expressao(~/[Õ|Ó|Ô]/).substituirPor("")
  .expressao(~/[ü|ú|û]/).substituirPor("")
  .expressao(~/[Ú|Ü|Û]/).substituirPor("")
  .expressao(~/[ç]/).substituirPor("")
  .expressao(~/[Ç]/).substituirPor("")
  .expressao(~/  /).substituirPor("")
  .expressao(~/[A-z]/).substituirPor("")
  .expressao(~/[,|\\n\|\/\|_|!|@|#|$|%|¨|&|^|´|:|;|)|(|%]/).substituirPor("")              
}

